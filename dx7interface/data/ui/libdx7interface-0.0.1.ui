  <object class="GtkBox" id="box_main">
    <property name="name">Dx7interface</property>
    <property name="visible">True</property>
    <property name="can-focus">False</property>
    <property name="hexpand">True</property>
    <property name="vexpand">True</property>
    <property name="baseline-position">top</property>
    <child>
      <object class="GtkRevealer" id="revealer_bank">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="transition-type">slide-left</property>
        <property name="reveal-child">True</property>
        <child>
          <object class="GtkFrame" id="frame_load_bank">
            <property name="width-request">160</property>
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="label-xalign">0</property>
            <property name="shadow-type">out</property>
            <child>
              <object class="GtkBox" id="box_bank">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="orientation">vertical</property>
                <child>
                  <object class="GtkFileChooserButton" id="bank_select">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="border-width">2</property>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">False</property>
                    <property name="position">0</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkScrolledWindow" id="scrolledwindow2">
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <child>
                      <object class="GtkViewport" id="viewport1">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="resize-mode">queue</property>
                        <child>
                          <object class="GtkTreeView" id="treeview_bank">
                            <property name="visible">True</property>
                            <property name="can-focus">True</property>
                            <property name="events">GDK_POINTER_MOTION_MASK | GDK_STRUCTURE_MASK</property>
                            <property name="model">liststore_bank</property>
                            <property name="headers-clickable">False</property>
                            <property name="search-column">0</property>
                            <child internal-child="selection">
                              <object class="GtkTreeSelection"/>
                            </child>
                            <child>
                              <object class="GtkTreeViewColumn" id="col_num">
                                <property name="sizing">autosize</property>
                                <property name="title">N°</property>
                                <child>
                                  <object class="GtkCellRendererText" id="cell_num"/>
                                  <attributes>
                                    <attribute name="text">0</attribute>
                                  </attributes>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkTreeViewColumn" id="col_name">
                                <property name="sizing">autosize</property>
                                <property name="title">Instrument</property>
                                <child>
                                  <object class="GtkCellRendererText" id="cell_name"/>
                                  <attributes>
                                    <attribute name="text">1</attribute>
                                  </attributes>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                  <packing>
                    <property name="expand">True</property>
                    <property name="fill">True</property>
                    <property name="position">1</property>
                  </packing>
                </child>
              </object>
            </child>
            <child type="label">
              <object class="GtkLabel" id="label_load_sound">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="label" translatable="yes">Banque de sons :</property>
                <property name="single-line-mode">True</property>
