[Desktop Entry]
Name=@PACKAGE_NAME@
GenericName=@PACKAGE_NAME@-@VERSION@ @LIB_VERSION@
Comment=Control Plugin of Dx7 synthetizer
Comment[fr]=Module de controle du synthetiseur Dx7
Exec=gxinterface -m /usr/share/@PACKAGE_NAME@/@VERSION@/@PACKAGE_NAME@-@LIB_VERSION@.la
Icon=@PROGRAMNAME_IMG_DIR@@PACKAGE_NAME@.png
Terminal=false
Type=Application
Categories=GTK;GNOME;AudioVideo;Audio;X-Synthesis;
Keywords=Synthesizer;Plugin;
