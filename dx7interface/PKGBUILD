# Maintainer: Jerome <>
# Contributor: Jmeshmesh <>

pkgname=dx7interface
pkgver='1.0.0'
pkgrel='1'
pkgdesc="Gtk Extended Interface: Module Loader for .la or .ui, provides headers for module construction"
arch=('i686' 'x86_64')
url="https://git.savannah.nongnu.org/git/${pkgname}.git"
license=('GPL')
depends=('glibmm-2.68' 'gtkmm-4.0' 'cairomm-1.16' 'alsa-lib' 'gxinterface')
makedepends=('git' 'intltool' 'gtkmm-4.0' 'cairomm-1.16' 'alsa-lib' 'autoconf' 'autogen' 'automake' 'libtool' 'gettext' 'base-devel' 'm4' 'libsigc++-3.0' 'glibmm-2.68' 'pangomm-2.48' 'gxinterface')
provides=(${pkgname})
conflicts=(${pkgname})
options=(libtool)

source=("git+https://git.savannah.nongnu.org/git/gxinterface.git#branch=gtk4")
md5sums=('SKIP')

build() {
    cd gxinterface/${pkgname}/
    ./autogen.sh --prefix=/usr --disable-maintainer-mode 'CFLAGS=-O2' 'CXXFLAGS=-O2'
    make
}

package() {
    cd gxinterface/${pkgname}
    make DESTDIR="$pkgdir" install
}
post_install(){
    fc-cache -fv $pkgdir/$pkgver/fonts
	fc-cache -fv $(DESTDIR)$(fontsdir)
}
