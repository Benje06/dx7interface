pkgname=dx7interface
pkgver='2.0.0'
pkgrel='1'
pkgdesc="Gtk Extended Interface: Module Loader for .la or .ui, provides headers for module construction"
arch=('i686' 'x86_64')
url="https://github.com/Benje06/${pkgname}.git"
license=('GPL')
depends=('glibmm-2.68' 'gtkmm-4.0' 'cairomm-1.16' 'alsa-lib' 'gxinterface')
makedepends=('git' 'intltool' 'gtkmm-4.0' 'cairomm-1.16' 'alsa-lib' 'autoconf' 'autogen' 'automake' 'libtool' 'gettext' 'base-devel' 'm4' 'libsigc++-3.0' 'glibmm-2.68' 'pangomm-2.48' 'gxinterface')
provides=(${pkgname})
conflicts=(${pkgname})
options=(libtool)

source=("git+file:///home/jerome/dev/git/gtk4")
md5sums=('SKIP')

build() {
    cd gtk4/${pkgname}/
    echo ""
    echo "*** CLEANING DIRECTORY ***"
    echo ""
    make clean || true
    make distclean || true
    echo ""
    echo "*** AUTOGEN / CONFIGURE ***"
    echo ""
    GTK_DEBUG=builder,modules,layout,interactive G_DEBUG=all G_ENABLE_DIAGNOSTIC=1 ./autogen.sh --prefix=/usr --enable-maintainer-mode --enable-dev --enable-alsa --enable-debug=2 'CFLAGS=-DGIOMM_DISABLE_DEPRECATED -DGLIBMM_DISABLE_DEPRECATED -DGDKMM_DISABLE_DEPRECATED -DGTKMM_DISABLE_DEPRECATED -DGDK_DISABLE_DEPRECATED -DGTK_DISABLE_DEPRECATED -ggdb3 -O0 -Wall -Wextra -Wno-unused-but-set-variable' 'CXXFLAGS=-DGIOMM_DISABLE_DEPRECATED -DGLIBMM_DISABLE_DEPRECATED -DGDKMM_DISABLE_DEPRECATED -DGTKMM_DISABLE_DEPRECATED -DGDK_DISABLE_DEPRECATED -DGTK_DISABLE_DEPRECATED -ggdb3 -O0 -Wall -fno-inline -std=c++17 -Wno-unused-but-set-variable'
    echo ""
    echo "*** MAKE ***"
    echo ""
    GTK_DEBUG=builder,modules,layout,interactive G_DEBUG=all G_ENABLE_DIAGNOSTIC=1 make
}

package() {
    echo ""
    echo "*** PACKAGING ***"
    echo ""
    cd gtk4/${pkgname}
    GTK_DEBUG=builder,modules,layout,interactive G_DEBUG=all G_ENABLE_DIAGNOSTIC=1 make DESTDIR="$pkgdir/" install
}
post_install(){
    fc-cache -f
}
