# Maintainer: Jerome <>
# Contributor: Jmeshmesh <>

pkgname=gxinterface
pkgver='2.0.0'
pkgrel='1'
pkgdesc="Gtk Extended Interface: Module Loader for .la or .ui, provides headers for module construction"
arch=('i686' 'x86_64')
url="https://git.savannah.nongnu.org/git/${pkgname}.git"
license=('GPL')
depends=('glibmm-2.68' 'gtkmm-4.0' 'cairomm-1.16' 'alsa-lib')
makedepends=('breezy' 'intltool' 'gtkmm-4.0' 'cairomm-1.16' 'alsa-lib' 'autoconf' 'autogen' 'automake' 'libtool' 'gettext' 'base-devel' 'm4' 'libsigc++-3.0' 'glibmm-2.68' 'pangomm-2.48')
provides=(${pkgname})
conflicts=(${pkgname})

source=("git+https://git.savannah.nongnu.org/git/${pkgname}.git#branch=gtk4")
md5sums=('SKIP')

build() {
    cd ${pkgname}/${pkgname}/
    ./autogen.sh --prefix=/usr --disable-maintainer-mode 'CFLAGS=-O2' 'CXXFLAGS=-O2'
    make
}

package() {
    cd ${pkgname}/${pkgname}
    make DESTDIR="$pkgdir/" install
}

