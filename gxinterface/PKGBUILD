# Maintainer: Jerome <>
# Contributor: Jmeshmesh <>

pkgname=gxinterface
pkgver='2.0.0'
pkgrel='1'
pkgdesc="Gtk Extended Interface: Module Loader for .la or .ui, provides headers for module construction"
arch=('i686' 'x86_64')
url="https://github.com/Benje06/dx7interface.git"
license=('GPL')
depends=('glibmm-2.68' 'gtkmm-4.0' 'cairomm-1.16' 'alsa-lib')
makedepends=('breezy' 'intltool' 'gtkmm-4.0' 'cairomm-1.16' 'alsa-lib' 'autoconf' 'autogen' 'automake' 'libtool' 'gettext' 'base-devel' 'm4' 'libsigc++-3.0' 'glibmm-2.68' 'pangomm-2.48')
provides=(${pkgname})
conflicts=(${pkgname})

source=("git+https://github.com/Benje06/dx7interface.git")
md5sums=('SKIP')

build() {
    cd dx7interface/${pkgname}/
    echo ""
    echo "*** CLEANING DIRECTORY ***"
    echo ""
    make clean || true
    make distclean || true
    echo ""
    echo "*** AUTOGEN / CONFIGURE ***"
    echo ""
    echo "./autogen.sh --prefix=/usr --disable-maintainer-mode --enable-debug=0 'CFLAGS=-O3 -march=native -mtune=native -fassociative-math -freciprocal-math -Wno-unused-but-set-variable' 'CXXFLAGS=-O3 -march=native -mtune=native -Wno-unused-but-set-variable'"
    ./autogen.sh --prefix=/usr --disable-maintainer-mode --enable-debug=0 'CFLAGS=-O3 -march=native -mtune=native -fassociative-math -freciprocal-math -Wno-unused-but-set-variable' 'CXXFLAGS=-O3 -march=native -mtune=native -Wno-unused-but-set-variable'
    echo ""
    echo "*** MAKE ***"
    echo ""
    echo "make -j3"
    make -j3
}

package() {
    echo ""
    echo "*** PACKAGING ***"
    echo ""
    echo "make DESTDIR=\"$pkgdir/\" install"
    cd dx7interface/${pkgname}/
    make DESTDIR="$pkgdir/" install
}

