[Desktop Entry]
Name=@PACKAGE_NAME@
GenericName=@PACKAGE_NAME@-@VERSION@ @LIB_VERSION@
Comment=Module Loader
Comment[fr]=Gestionnaire de modules
Exec=@PACKAGE_NAME@
Icon=/usr/share/@PACKAGE_NAME@/@VERSION@/images/@PACKAGE_NAME@.jpg
Terminal=false
Type=Application
Categories=GTK;GNOME;AudioVideo;Audio;X-Synthesis;
Keywords=Synthesizer;Plugin;
