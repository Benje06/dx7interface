prefix=@prefix@
eprefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: @PACKAGE_NAME@
Description: Gnome eXtended Interface. interface, module manager and gx_module.
Version: @PACKAGE_VERSION@
URL: @PACKAGE_URL@
Libs: -L${libdir} -l@PACKAGE_NAME@-@LIB_VERSION@
Cflags: -I${includedir}/@PACKAGE_NAME@/@LIB_VERSION@ -I${libdir}/@PACKAGE_NAME@/@LIB_VERSION@/include
