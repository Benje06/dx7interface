    myarea->queue_draw();
}

double* Draw::get_cr_size(const Cairo::RefPtr<Cairo::Context>& cr){
    LOG_IN();
    // get current size of the cr
    double *size = nullptr;
    size = new double[2];
    double x1, y1, x2, y2;
    cr->get_clip_extents(x1, y1, x2, y2);
    size[0] = x2 - x1; // width
    size[1] = y2 - y1; // height*/
    LOG_OUT();
    return size;
}

bool Draw::on_draw_event(const Cairo::RefPtr<Cairo::Context>& cr){
    LOG_IN();
        /* pour dessiner la courbe EG */
    if (cr){
        double width=0;
        double height=0;
        auto size = get_cr_size(cr);
        if(!size){
            return TRUE;
        }else{
            width = size[0];
            height = size[1];
        }
        
        std::cout << "Drawing area size: " << width << "x" << height << std::endl;
        cr->save();
        cr->set_source_rgb(0.2, 0.2, 0.2);
        cr->rectangle(0, 0, 100, 100);
        cr->fill();
        cr->restore();
        
        cr->set_line_width(10.0);
        if(xo > width || yo > height ){
            xo=0, yo=0;
        }
	    for(guint8 i=1;i<=4;i++) {
		    cr->save();
            cr->move_to(xo, yo);
		    xo += 20;
		    yo += 20;
		    cr->line_to(xo, yo);
		    cr->stroke(); // paint element
		    cr->restore();
	    };
    };
    LOG_OUT();
    return TRUE;
};


