void Draw::add_rectangle(int x, int y, int width, int height) {
    rectangles.emplace_back(x, y, width, height);
    (get_gwidget<Gtk::DrawingArea>("drawingarea"))->queue_draw();  // Request a redraw
}


bool Draw::on_draw_event_ev(const Cairo::RefPtr<Cairo::Context>& cr){
    LOG_IN();
    if (cr){
        guint xo=0, yo=0;   // coordonee du point
        double width=0;     // largeur drawarea
        double height=0;    // hauteru drawarea
        
        auto size = get_cr_size(cr);
        if(!size){
            return TRUE;
        }else{
            width = size[0];
            height = size[1];
        }

        cr->set_source_rgba(0.0, 0.0, 0.0,1.0);
	    cr->paint();	// fill with color
        cr->restore();
        cr->save();        
	    cr->set_source_rgb(0.4,0.8,0.6); 
	    cr->set_line_width(2);

	    // se dit taille / 400
	    // le resultat deviens le multiplicateur

        int eg_rt[4] = {43,56,23,99};
        int eg_lvl[4] = {99,39,42,10};
        
	    for(guint8 i=0;i<=3;i++) {
		    if (i==0) {
			    cr->move_to(xo, height - eg_lvl[3]);
		    }else{
			    cr->move_to(xo, yo);
		    };
		    if (i==4) {
			    xo = width;
		    }else{
		    /* (plage - val /2)/0.678 to fit size*/
			    xo += (( 99 - eg_rt[i] ) /2 ) /0.678;
		    }
		    yo = height - eg_lvl[i];
		    cr->line_to(xo, yo);
            cr->fill_preserve();
		    cr->stroke_preserve();   // draw line
	    };
        cr->restore();
    };
    LOG_OUT();   
    return TRUE;
}


bool Draw::on_draw_event2(const Cairo::RefPtr<Cairo::Context>& cr)
{
    // get current size of the cr
    double x1, y1, x2, y2;
    cr->get_clip_extents(x1, y1, x2, y2);
    double width = x2 - x1;
    double height = y2 - y1;
    
    std::cout << "Drawing area size: " << width << "x" << height << std::endl;
    cr->set_source_rgb(1.0, 1.0, 1.0);
    cr->paint();
    
    cr->save();
    cr->set_source_rgb(0.2, 0.2, 0.2);
    for (const auto& rect : rectangles) {
        cr->rectangle(rect.get_x(), rect.get_y(), rect.get_width(), rect.get_height());
        cr->fill();
    }
    cr->restore();
    return TRUE;
}


bool Draw::on_timeout() {
    myarea->queue_draw();
    return TRUE; // Keep the timeout active
}

