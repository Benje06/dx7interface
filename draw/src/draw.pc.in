prefix=@prefix@
eprefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: lib@PACKAGE_NAME@
Description: load module synth library.
Version: @PACKAGE_VERSION@
URL: @PACKAGE_URL@
Libs: -L${PROGRAMNAME_MOD_DIR} -l@PACKAGE_NAME@-@API_VERSION@ 
Cflags: -I${includedir}/lib@PACKAGE_NAME@-@API_VERSION@ -I${PROGRAMNAME_MOD_DIR}/lib@PACKAGE_NAME@-@API_VERSION@/include
